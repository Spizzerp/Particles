type ZKProof = 
 record {
   a: record {
        text;
        text;
      };
   b: record {
        record {
          text;
          text;
        };
        record {
          text;
          text;
        };
      };
   c: record {
        text;
        text;
      };
   publicSignals: vec text;
 };
type Withdrawal = 
 record {
   amount: Amount;
   chainId: ChainId;
   id: nat;
   merkleRoot: MerkleRoot;
   nullifier: NullifierHash;
   proof: ZKProof;
   recipient: text;
   timestamp: Time;
   tokenId: TokenId;
 };
type TokenId = text;
type Time = int;
type Result_1 = 
 variant {
   err: text;
   ok: nat;
 };
type Result = 
 variant {
   err: text;
   ok;
 };
type PlonkProof = 
 record {
   batched_proof: record {
                    claimed_values: vec text;
                    h: record {
                         text;
                         text;
                       };
                  };
   bsb22_commitments: vec record {
                            text;
                            text;
                          };
   h: vec record {
            text;
            text;
          };
   lro: vec record {
              text;
              text;
            };
   z: record {
        text;
        text;
      };
   zshifted_proof: record {
                     claimed_value: text;
                     h: record {
                          text;
                          text;
                        };
                   };
 };
type NullifierHash = text;
type MerkleRoot = text;
type ChainId = nat;
type Amount = nat;
service : {
  getPendingWithdrawals: () -> (vec Withdrawal) query;
  getProcessedWithdrawals: () -> (vec Withdrawal) query;
  getVerificationCost: () ->
   (record {
      cycles: nat;
      instructions: nat;
      usdCost: float64;
    }) query;
  getWithdrawal: (nat) -> (opt Withdrawal) query;
  initiateWithdrawal: (NullifierHash, text, Amount, TokenId, ChainId,
   MerkleRoot, PlonkProof) -> (Result_1);
  isNullifierUsed: (NullifierHash) -> (bool) query;
  processWithdrawal: (nat) -> (Result);
  setPlonkVerificationKey: (vec nat8) -> (Result);
}
