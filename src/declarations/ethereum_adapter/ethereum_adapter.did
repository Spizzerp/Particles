type Result_8 = 
 variant {
   err: text;
   ok: vec DepositEvent;
 };
type Result_7 = 
 variant {
   err: text;
   ok: record {
         address: text;
         publicKey: text;
       };
 };
type Result_6 = 
 variant {
   err: text;
   ok: record {
         legacy: text;
         proper: text;
         publicKey: text;
       };
 };
type Result_5 = 
 variant {
   err: text;
   ok:
    record {
      estimatedGasPrice: nat;
      estimatedTotalCost: nat;
      estimatedTotalCostEth: text;
      gasLimit: nat;
    };
 };
type Result_4 = 
 variant {
   err: text;
   ok: vec text;
 };
type Result_3 = 
 variant {
   err: text;
   ok;
 };
type Result_2 = 
 variant {
   err: text;
   ok: nat;
 };
type Result_1 = 
 variant {
   err: text;
   ok: text;
 };
type Result = 
 variant {
   err: text;
   ok:
    record {
      addressMatches: bool;
      canSign: bool;
      derivedFromSigning: text;
      generatedAddress: text;
      storedTimestamp: int;
    };
 };
type DepositInfo = 
 record {
   amount: nat;
   commitment: text;
   processed: bool;
   timestamp: int;
   userId: principal;
 };
type DepositEvent = 
 record {
   amount: nat;
   blockNumber: nat;
   commitment: text;
   sender: text;
   timestamp: int;
   txHash: text;
 };
service : {
  acceptCycles: () -> (nat);
  checkDeposits: () -> (Result_8);
  debugAddressGeneration: (principal) -> (Result_7);
  debugCompareAddressGeneration: (principal) -> (Result_6);
  forceProcessDeposit: (text) -> (Result_1);
  getCurrentMerkleRoot: () -> (Result_1);
  getCycleBalance: () -> (nat) query;
  getDepositAddress: (principal, text, nat) -> (Result_1);
  getDepositAddressV2: (principal, text, nat) -> (Result_1);
  getDepositContract: () -> (text) query;
  getDepositGasEstimate: () -> (Result_5);
  getDepositInfo: (text) -> (opt DepositInfo) query;
  getKeccak256CanisterId: () -> (text) query;
  getPendingDeposits: () -> (vec record {
                                   text;
                                   DepositInfo;
                                 }) query;
  getPoolAddress: () -> (text);
  markDepositAsProcessed: (text, text) -> (Result_1);
  migrateOldDeposit: (text) -> (Result_1);
  processDepositAddresses: () -> (Result_4);
  processSingleDeposit: (text) -> (Result_1);
  processSingleDepositEIP1559: (text) -> (Result_1);
  processSingleDepositV2: (text) -> (Result_1);
  recoverStuckFunds: (text, text) -> (Result_1);
  resetDepositStatus: (text) -> (Result_1);
  retryV2Deposit: (text) -> (Result_1);
  setDepositContract: (text) -> (Result_3);
  setKeccak256CanisterId: (text) -> (Result_3);
  testGetNonce: (text) -> (Result_2);
  testRustForwarding: (text) -> (Result_1);
  testRustForwardingEIP1559: (text) -> (Result_1);
  testSimpleTransfer: (text) -> (Result_1);
  verifyV2AddressDerivation: (text) -> (Result);
}
