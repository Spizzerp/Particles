type Wei = nat;
type Satoshi = nat64;
type Result_5 = 
 variant {
   err: text;
   ok: BitcoinAddress;
 };
type Result_4 = 
 variant {
   err: text;
   ok: EthereumAddress;
 };
type Result_3 = 
 variant {
   err: text;
   ok: Satoshi;
 };
type Result_2 = 
 variant {
   err: text;
   ok: Wei;
 };
type Result_1 = 
 variant {
   err: text;
   ok: text;
 };
type Result = 
 variant {
   err: text;
   ok: blob;
 };
type EthereumAddress = text;
type ChainFusionManager = 
 service {
   bridgeFromBitcoin: (principal, Satoshi, text) -> (Result_1);
   bridgeFromEthereum: (principal, Wei, text) -> (Result_1);
   generateBitcoinAddress: (principal) -> (Result_5);
   generateEthereumAddress: (principal) -> (Result_4);
   getBitcoinBalance: (BitcoinAddress) -> (Result_3);
   getEthereumBalance: (EthereumAddress) -> (Result_2);
   getKeyName: () -> (text) query;
   getSupportedChains: () -> (vec text) query;
   sendBitcoinTransaction: (principal, BitcoinAddress, Satoshi,
    BitcoinNetwork) -> (Result_1);
   sendEthereumTransaction: (principal, EthereumAddress, Wei) -> (Result_1);
   signWithEcdsa: (principal, blob) -> (Result);
 };
type BitcoinNetwork = 
 variant {
   mainnet;
   regtest;
   testnet;
 };
type BitcoinAddress = text;
service : (record {
             ethereum_rpc: text;
             key_name: text;
           }) -> ChainFusionManager
