type TokenId = text;
type Time = int;
type Result_2 = 
 variant {
   err: text;
   ok: vec text;
 };
type Result_1 = 
 variant {
   err: text;
   ok: DepositResult;
 };
type Result = 
 variant {
   err: text;
   ok: text;
 };
type DepositResult = 
 record {
   depositId: nat;
   leafIndex: nat;
   merkleRoot: text;
 };
type Deposit = 
 record {
   amount: Amount;
   chainId: ChainId;
   commitment: CommitmentHash;
   id: nat;
   leafIndex: nat;
   timestamp: Time;
   tokenId: TokenId;
   user: principal;
 };
type CommitmentHash = text;
type ChainId = nat;
type Amount = nat;
service : {
  acceptCycles: () -> (nat);
  deposit: (Amount, TokenId, ChainId, CommitmentHash) -> (Result_1);
  getAllDeposits: () -> (vec Deposit) query;
  getCommitmentsInOrder: () -> (vec text) query;
  getCurrentMerkleRoot: () -> (text) query;
  getCycleBalance: () -> (nat) query;
  getDeposit: (nat) -> (opt Deposit) query;
  getMerkleProof: (nat) -> (Result_2) query;
  getTotalDeposits: () -> (nat) query;
  getUserDeposits: (principal) -> (vec Deposit) query;
  migrateDeposit: (nat, principal, nat, text, nat, text, int) -> (Result_1);
  resetMerkleTree: () -> (Result);
  verifyMerkleProof: (text, nat, vec text, text) -> (bool) query;
}
