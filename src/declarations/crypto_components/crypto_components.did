type ZKProof = 
 record {
   a: record {
        text;
        text;
      };
   b: record {
        record {
          text;
          text;
        };
        record {
          text;
          text;
        };
      };
   c: record {
        text;
        text;
      };
   publicSignals: vec text;
 };
type Result_5 = 
 variant {
   err: text;
   ok: nat;
 };
type Result_4 = 
 variant {
   err: text;
   ok: text;
 };
type Result_3 = 
 variant {
   err: text;
   ok: CommitmentHash;
 };
type Result_2 = 
 variant {
   err: text;
   ok: NullifierHash;
 };
type Result_1 = 
 variant {
   err: text;
   ok: ZKProof;
 };
type Result = 
 variant {
   err: text;
   ok: vec CommitmentHash;
 };
type NullifierHash = text;
type MerkleRoot = text;
type CommitmentHash = text;
service : {
  addLeaf: (CommitmentHash) -> (Result_5);
  decryptData: (text, text) -> (Result_4);
  encryptData: (text, text) -> (Result_4);
  generateCommitment: (text, text, nat) -> (Result_3);
  generateNullifier: (text, nat) -> (Result_2);
  generateZKProof: (text, text, text, nat, MerkleRoot, vec CommitmentHash,
   nat) -> (Result_1);
  getCurrentMerkleRoot: () -> (opt MerkleRoot) query;
  getLeafCount: () -> (nat) query;
  getMerkleProof: (nat) -> (Result);
  getMerkleRootAtLevel: (nat) -> (opt MerkleRoot) query;
  getTreeDepth: () -> (nat) query;
  verifyMerkleProof: (CommitmentHash, vec CommitmentHash, MerkleRoot, 
   nat) -> (bool);
}
