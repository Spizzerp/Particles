type MimcHashInput = record {
    left: text;
    right: text;
};

type MimcHashResult = record {
    hash: text;
};

type MimcMultiHashInput = record {
    elements: vec text;
};

service : {
    mimc_hash: (MimcHashInput) -> (MimcHashResult);
    mimc_sponge: (MimcMultiHashInput) -> (MimcHashResult);
    mimc_compress: (MimcHashInput) -> (MimcHashResult);
    mimc_hash_bytes: (vec nat8, vec nat8) -> (vec nat8);
    compute_merkle_root: (text, vec text) -> (MimcHashResult);
    get_constants_count: () -> (nat) query;
    verify_mimc_test: () -> (text) query;
}