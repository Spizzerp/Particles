    // HTTP types
    type HttpRequestArgs = {
        url : Text;
        max_response_bytes : ?Nat64;
        headers : [{ name : Text; value : Text }];
        body : ?Blob;
        method : { #get; #post; #head };
        transform : ?{
            function : shared query {
                response : {
                    status : Nat;
                    headers : [{ name : Text; value : Text }];
                    body : Blob;
                };
                context : Blob;
            } -> async {
                status : Nat;
                headers : [{ name : Text; value : Text }];
                body : Blob;
            };
            context : Blob;
        };
    };
    
    type HttpResponsePayload = {
        status : Nat;
        headers : [{ name : Text; value : Text }];
        body : Blob;
    };
    
    // Transaction types
    type EthereumTransaction = {
        to: Text;
