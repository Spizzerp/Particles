    // System functions for upgrades
    system func preupgrade() {
        depositAddressesStable := Iter.toArray(depositAddresses.entries());
        processedDepositsStable := Iter.toArray(processedDeposits.entries());
    };

    system func postupgrade() {
        depositAddresses := Map.fromIter(depositAddressesStable.vals(), depositAddressesStable.size(), Text.equal, Text.hash);
        processedDeposits := Map.fromIter(processedDepositsStable.vals(), processedDepositsStable.size(), Text.equal, Text.hash);
        depositAddressesStable := [];
        processedDepositsStable := [];
    };

    // Generate unique Ethereum address for deposits
    public shared(msg) func getDepositAddress(userId: Principal, commitment: Text, amount: Nat) : async Result.Result<Text, Text> {
        try {
            // Validate inputs
            if (Text.size(commitment) != 66) { // 0x + 64 hex chars
                return #err("Invalid commitment format");
            };
            if (amount == 0) {
                return #err("Amount must be greater than 0");
            };
            
            // Generate UNIQUE derivation path by combining user + commitment + timestamp
            // This ensures each deposit gets a unique address
            let uniqueData = Text.encodeUtf8(
                Principal.toText(userId) # 
                commitment # 
                Int.toText(Time.now())
            );
            let uniqueHash = await keccak256(uniqueData);
            let hashBytes = Blob.toArray(uniqueHash);
            
            // Use first 4 bytes of the hash for derivation path
            let derivationPath = [Blob.fromArray([hashBytes[0], hashBytes[1], hashBytes[2], hashBytes[3]])];
            
            Debug.print("Generating deposit address for user: " # Principal.toText(userId));
            Debug.print("Commitment: " # commitment);
            Debug.print("Amount: " # Nat.toText(amount) # " wei");
            Debug.print("Unique derivation path generated");
            
            // Get the Ethereum address for this derivation path
            let publicKey = await getEcdsaPublicKey(derivationPath);
            let ethAddress = await publicKeyToEthAddress(publicKey.public_key);
            
            Debug.print("Generated Ethereum address: " # ethAddress);
            
            // Store deposit info with the address
            depositAddresses.put(ethAddress, {
                commitment = commitment;
                amount = amount;
                timestamp = Time.now();
                userId = userId;
                processed = false;
            });
            
            #ok(ethAddress)
        } catch (e) {
            #err("Error generating deposit address: " # Error.message(e))
        }
    };

    // Get deposit address with V2 derivation (using user + commitment + timestamp)
    public shared(msg) func getDepositAddressV2(userId: Principal, commitment: Text, amount: Nat) : async Result.Result<Text, Text> {
        try {
            // Validate inputs
            if (Text.size(commitment) != 66) { // 0x + 64 hex chars
                return #err("Invalid commitment format");
            };
            if (amount == 0) {
                return #err("Amount must be greater than 0");
            };
            
            // Generate UNIQUE derivation path by combining user + commitment + timestamp
            // This ensures each deposit gets a unique address even for same user/commitment
            let timestamp = Time.now();
            let uniqueData = Text.encodeUtf8(
                Principal.toText(userId) # 
                commitment # 
                Int.toText(timestamp)
            );
            let uniqueHash = await keccak256(uniqueData);
            let hashBytes = Blob.toArray(uniqueHash);
            
            // Use first 4 bytes of the hash for derivation path
            let derivationPath = [Blob.fromArray([hashBytes[0], hashBytes[1], hashBytes[2], hashBytes[3]])];
            
            Debug.print("=== V2 DEPOSIT ADDRESS GENERATION ===");
            Debug.print("User: " # Principal.toText(userId));
            Debug.print("Commitment: " # commitment);
            Debug.print("Amount: " # Nat.toText(amount) # " wei");
            Debug.print("Timestamp: " # Int.toText(timestamp));
            Debug.print("Unique derivation path generated from hash");
            
            // Get the Ethereum address for this derivation path
            let publicKey = await getEcdsaPublicKey(derivationPath);
            let ethAddress = await publicKeyToEthAddress(publicKey.public_key);
            
            Debug.print("Generated Ethereum address: " # ethAddress);
            
            // Store deposit info with the address
            // CRITICAL: Store the EXACT timestamp used for derivation
            depositAddresses.put(ethAddress, {
                commitment = commitment;
                amount = amount;
                timestamp = timestamp; // This MUST match what was used in uniqueData
                userId = userId;
                processed = false;
            });
            
            Debug.print("Deposit info stored with timestamp: " # Int.toText(timestamp));
            
            #ok(ethAddress)
        } catch (e) {
            #err("Error generating V2 deposit address: " # Error.message(e))
        }
    };

    // ==== NEW CLEAN IMPLEMENTATION ====
    // Process deposit with proper gas prices (no Rust canister dependency)
    public shared(msg) func processDepositClean(address: Text) : async Result.Result<Text, Text> {
        // Check cycles before processing
        if (not hasSufficientCycles()) {
            return #err("Insufficient cycles. Please top up the canister.");
        };
        
        // Find the deposit info
        switch (depositAddresses.get(address)) {
            case null { #err("Deposit address not found") };
            case (?info) {
                if (info.processed) {
                    return #err("Deposit already processed");
                };
                
                // Ensure deposit contract is set
                if (depositContractAddress == "") {
                    return #err("Deposit contract address not set");
                };
                
                try {
                    Debug.print("=== CLEAN DEPOSIT PROCESSING ===");
                    Debug.print("Address: " # address);
                    Debug.print("Amount: " # Nat.toText(info.amount));
                    
                    // Get current gas prices
                    let gasPrices = switch (await getGasPrices()) {
                        case (#ok(prices)) { prices };
                        case (#err(e)) { return #err("Failed to get gas prices: " # e) };
                    };
                    
                    Debug.print("Current gas prices - Base: " # Nat.toText(gasPrices.baseFee) # 
                               ", Priority: " # Nat.toText(gasPrices.maxPriorityFee));
                    
                    // Forward using clean EIP-1559 implementation
                    let forwardResult = await forwardWithCleanEIP1559(address, info, gasPrices);
                    
                    switch (forwardResult) {
                        case (#ok(txHash)) {
                            Debug.print("Transaction submitted: " # txHash);
                            
                            // Wait briefly then check status
                            let confirmResult = await waitForTransactionConfirmation(txHash);
                            
                            switch (confirmResult) {
                                case (#ok(receipt)) {
                                    if (receipt.status == "0x1") {
                                        // Success - mark as processed
                                        depositAddresses.put(address, {
                                            commitment = info.commitment;
                                            amount = info.amount;
                                            timestamp = info.timestamp;
                                            userId = info.userId;
                                            processed = true;
                                        });
                                        
                                        // Add to deposit manager
                                        try {
                                            let depositResult = await depositManager.deposit(
                                                info.amount,
                                                "ETH",
                                                11155111,
                                                info.commitment
                                            );
                                            Debug.print("Deposit registered in manager");
                                        } catch (e) {
                                            Debug.print("Warning: Failed to register in deposit manager");
                                        };
                                        
                                        #ok(txHash)
                                    } else if (receipt.status == "0x2") {
                                        // Still pending
                                        #ok(txHash # ":pending")
                                    } else {
                                        #err("Transaction failed")
                                    }
                                };
                                case (#err(e)) {
                                    #err("Transaction not confirmed: " # e)
                                };
                            }
                        };
                        case (#err(e)) {
                            #err("Failed to forward: " # e)
                        };
                    }
                } catch (e) {
                    #err("Error: " # Error.message(e))
                }
            };
        }
    };

    // Clean EIP-1559 forwarding implementation
    private func forwardWithCleanEIP1559(
        depositAddress: Text, 
        info: DepositInfo,
        gasPrices: {baseFee: Nat; maxPriorityFee: Nat}
    ) : async Result.Result<Text, Text> {
        try {
            // Get nonce
            ExperimentalCycles.add(2_000_000_000);
            let nonceResult = await evmRpc.eth_getTransactionCount(
                #EthSepolia(?[#PublicNode]),
                ?{ responseSizeEstimate = ?64; responseConsensus = null; },
                { address = depositAddress; block = #Latest; }
            );
            
            let nonce = switch (nonceResult) {
                case (#Consistent(#Ok(n))) { n };
                case (_) { return #err("Failed to get nonce") };
            };
            
            // Calculate gas parameters with 20% buffer for safety
            let maxFeePerGas = gasPrices.baseFee + gasPrices.maxPriorityFee + (gasPrices.baseFee / 5);
            let gasLimit : Nat = 80000;
            
            Debug.print("Transaction parameters:");
            Debug.print("  Nonce: " # Nat.toText(nonce));
            Debug.print("  Max Fee: " # Nat.toText(maxFeePerGas) # " (" # Nat.toText(maxFeePerGas / 1_000_000_000) # " gwei)");
            Debug.print("  Priority Fee: " # Nat.toText(gasPrices.maxPriorityFee) # " (" # Nat.toText(gasPrices.maxPriorityFee / 1_000_000_000) # " gwei)");
            Debug.print("  Gas Limit: " # Nat.toText(gasLimit));
            
            // Check balance
            let balanceResult = await getAddressBalance(depositAddress);
            let balance = switch (balanceResult) {
                case (#ok(b)) { b };
                case (#err(e)) { return #err("Failed to get balance: " # e) };
            };
            
            let totalGasNeeded = maxFeePerGas * gasLimit;
            let totalRequired = info.amount + totalGasNeeded;
            
            Debug.print("Balance check:");
            Debug.print("  Current balance: " # Nat.toText(balance));
            Debug.print("  Amount to forward: " # Nat.toText(info.amount));
            Debug.print("  Max gas cost: " # Nat.toText(totalGasNeeded));
            Debug.print("  Total required: " # Nat.toText(totalRequired));
            
            if (balance < totalRequired) {
                return #err("Insufficient balance. Have: " # Nat.toText(balance) # ", need: " # Nat.toText(totalRequired));
            };
            
            // Build call data for deposit function
            let methodId = "b214faa5"; // deposit(bytes32)
            let commitmentHex = Text.trimStart(info.commitment, #text "0x");
            let paddedCommitment = if (Text.size(commitmentHex) < 64) {
                let padding = Text.fromIter(Iter.fromArray(Array.tabulate(64 - Text.size(commitmentHex), func(_: Nat) : Char { '0' })));
                padding # commitmentHex
            } else {
                commitmentHex
            };
            let callDataHex = "0x" # methodId # paddedCommitment;
            
            // Build EIP-1559 transaction
            let tx : EIP1559Transaction = {
                to = depositContractAddress;
                value = info.amount;
                data = switch (Hex.decode(callDataHex)) {
                    case (#ok(bytes)) { Blob.fromArray(bytes) };
                    case (#err(_)) { return #err("Failed to encode call data") };
                };
                nonce = nonce;
                maxFeePerGas = maxFeePerGas;
                maxPriorityFeePerGas = gasPrices.maxPriorityFee;
                gasLimit = gasLimit;
                chainId = 11155111; // Sepolia
            };
            
            // Get derivation path for signing
            let uniqueData = Text.encodeUtf8(
                Principal.toText(info.userId) # 
                info.commitment # 
                Int.toText(info.timestamp)
            );
            let uniqueHash = await keccak256(uniqueData);
            let hashBytes = Blob.toArray(uniqueHash);
            let derivationPath = [Blob.fromArray([hashBytes[0], hashBytes[1], hashBytes[2], hashBytes[3]])];
            
            // Sign and submit
            let (signedTx, submitResult) = await signAndSubmitEIP1559Transaction(tx, derivationPath);
            
            switch (submitResult) {
                case (#Consistent(#Ok(sendStatus))) {
                    switch (sendStatus) {
                        case (#Ok(?txHash)) {
                            Debug.print("Transaction submitted successfully: " # txHash);
                            #ok(txHash)
                        };
                        case (#Ok(null)) { #err("No transaction hash returned") };
                        case (#NonceTooLow) { #err("Nonce too low") };
                        case (#NonceTooHigh) { #err("Nonce too high") };
                        case (#InsufficientFunds) { #err("Insufficient funds") };
                        case (#Err(e)) { #err("RPC error: " # debug_show(e)) };
                    }
                };
                case (#Consistent(#Err(e))) { #err("RPC error: " # debug_show(e)) };
                case (#Inconsistent(_)) { #err("Inconsistent RPC responses") };
            }
        } catch (e) {
            #err("Exception: " # Error.message(e))
        }
    };

    // Get address balance helper
    private func getAddressBalance(address: Text) : async Result.Result<Nat, Text> {
        let balanceRequest = "{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBalance\",\"params\":[\"" # 
                           address # "\",\"latest\"],\"id\":1}";
        
        ExperimentalCycles.add(2_000_000_000);
        let balanceResult = await evmRpc.request(
            #EthSepolia(#PublicNode),
            balanceRequest,
            2048
        );
        
        switch (balanceResult) {
            case (#Ok(response)) {
                let balanceHex = extractResultFromJson(response);
                #ok(hexToNat(balanceHex))
            };
            case (#Err(error)) {
                #err("Failed to get balance")
            };
        }
    };

