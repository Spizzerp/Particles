{
  "name": "particle-funds",
  "version": "0.1.0",
  "description": "Cross-chain privacy pool and financial infrastructure",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:full": "tsc && vite build && dfx build",
    "build:frontend": "vite build",
    "build:canisters": "dfx build",
    "deploy": "dfx deploy",
    "deploy:local": "dfx deploy --network local",
    "deploy:ic": "dfx deploy --network ic",
    "start": "dfx start --clean",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "generate": "dfx generate",
    "build:circuits": "cd circuits && ./build.sh"
  },
  "dependencies": {
    "@dfinity/agent": "^2.4.1",
    "@dfinity/auth-client": "^2.4.1",
    "@dfinity/candid": "^2.4.1",
