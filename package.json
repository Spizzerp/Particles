    "@dfinity/principal": "^2.4.1",
    "@nfid/identitykit": "^1.0.13",
    "@noble/hashes": "^1.3.3",
    "buffer": "^6.0.3",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "commander": "^12.0.0",
    "dotenv": "^16.6.0",
    "ethereum-cryptography": "^2.1.3",
    "ethers": "^6.13.4",
    "lucide-react": "^0.517.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "secp256k1": "^5.0.1",
