# Environment Configuration for Particle Funds

# DFX Network Configuration
VITE_DFX_NETWORK=local
VITE_HOST=http://localhost:4943

# Canister IDs (will be populated after deployment)
VITE_DEPOSIT_MANAGER_CANISTER_ID=
VITE_PARTICLE_ROUTER_CANISTER_ID=
VITE_PATTERN_BREAKER_CANISTER_ID=
VITE_WITHDRAWAL_PROCESSOR_CANISTER_ID=
VITE_CRYPTO_COMPONENTS_CANISTER_ID=
VITE_CHAIN_FUSION_MANAGER_CANISTER_ID=
VITE_TOKEN_REGISTRY_CANISTER_ID=

# Internet Identity
VITE_INTERNET_IDENTITY_CANISTER_ID=rdmx6-jaaaa-aaaaa-aaadq-cai

# Chain Configuration
VITE_BITCOIN_NETWORK=testnet
VITE_ETHEREUM_NETWORK=sepolia

# RPC Endpoints
VITE_ETHEREUM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Optional: Custom RPC endpoints for other services
VITE_INFURA_PROJECT_ID=
VITE_QUICKNODE_ENDPOINT=

# Feature Flags
VITE_ENABLE_MAINNET=false
VITE_ENABLE_TESTNET=true
VITE_ENABLE_DEVNET=true