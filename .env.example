# Environment Configuration for Particle Funds

# DFX Network Configuration
VITE_DFX_NETWORK=local
VITE_HOST=http://localhost:4943

# Canister IDs (will be populated after deployment)
VITE_DEPOSIT_MANAGER_CANISTER_ID=
VITE_PATTERN_BREAKER_CANISTER_ID=
VITE_WITHDRAWAL_PROCESSOR_CANISTER_ID=
VITE_ETHEREUM_ADAPTER_CANISTER_ID=

# Internet Identity
VITE_INTERNET_IDENTITY_CANISTER_ID=rdmx6-jaaaa-aaaaa-aaadq-cai

# Chain Configuration
VITE_BITCOIN_NETWORK=testnet
VITE_ETHEREUM_NETWORK=sepolia

# RPC Endpoints - Primary
VITE_ETHEREUM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Fallback RPC Providers
VITE_INFURA_PROJECT_ID=your_infura_project_id_here
VITE_ANKR_API_KEY=your_ankr_api_key_here
VITE_ANKR_RPC_URL=https://rpc.ankr.com/eth_sepolia/

# Public RPC Endpoints (no API key required)
VITE_PUBLIC_RPC_1=https://rpc.sepolia.org
VITE_PUBLIC_RPC_2=https://ethereum-sepolia.publicnode.com

# Feature Flags
VITE_ENABLE_MAINNET=false
VITE_ENABLE_TESTNET=true
VITE_ENABLE_DEVNET=true

# Ethereum Deployment Configuration
NETWORK=sepolia
PRIVATE_KEY=your_test_wallet_private_key_here
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY